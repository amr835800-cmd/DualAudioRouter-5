package com.example.dualaudiorouter

import android.Manifest
import android.bluetooth.BluetoothAdapter
import android.bluetooth.BluetoothManager
import android.content.Context
import android.content.Intent
import android.content.pm.PackageManager
import android.media.AudioDeviceInfo
import android.media.AudioManager
import android.os.Build
import androidx.core.content.ContextCompat

class AudioRouterManager(private val context: Context) {

    private val prefs = context.getSharedPreferences("routing_prefs", Context.MODE_PRIVATE)
    private val audioManager = context.getSystemService(Context.AUDIO_SERVICE) as AudioManager

    fun hasBluetoothPermission(): Boolean {
        return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
            ContextCompat.checkSelfPermission(
                context,
                Manifest.permission.BLUETOOTH_CONNECT
            ) == PackageManager.PERMISSION_GRANTED
        } else {
            true
        }
    }

    fun getLaunchableApps(): List<AppInfoItem> {
        val pm = context.packageManager
        val intent = Intent(Intent.ACTION_MAIN, null).apply {
            addCategory(Intent.CATEGORY_LAUNCHER)
        }

        val resolveList = pm.queryIntentActivities(intent, 0)
        return resolveList
            .map { info ->
                val pkg = info.activityInfo.packageName
                val label = info.loadLabel(pm).toString()
                val icon = info.loadIcon(pm)
                AppInfoItem(pkg, label, icon)
            }
            .filter { it.packageName != context.packageName }
            .distinctBy { it.packageName }
            .sortedBy { it.appName.lowercase() }
    }

    fun getAvailableAudioTargets(): List<AudioDeviceItem> {
        val targets = mutableListOf<AudioDeviceItem>()

        targets.add(
            AudioDeviceItem(
                id = "DEFAULT_SPEAKER",
                name = "سماعة الهاتف / الافتراضي",
                isBluetooth = false
            )
        )

        if (!hasBluetoothPermission()) {
            return targets
        }

        val bluetoothManager =
            context.getSystemService(Context.BLUETOOTH_SERVICE) as BluetoothManager
        val adapter: BluetoothAdapter? = bluetoothManager.adapter

        if (adapter != null && adapter.isEnabled) {
            try {
                adapter.bondedDevices?.forEach { device ->
                    targets.add(
                        AudioDeviceItem(
                            id = "BT_${device.address}",
                            name = device.name ?: "سماعة بلوتوث",
                            address = device.address,
                            isBluetooth = true
                        )
                    )
                }
            } catch (_: SecurityException) {
            }
        }

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
            val devices = audioManager.getDevices(AudioManager.GET_DEVICES_OUTPUTS)
            devices.forEach { info: AudioDeviceInfo ->
                if (info.type == AudioDeviceInfo.TYPE_BLUETOOTH_A2DP ||
                    info.type == AudioDeviceInfo.TYPE_BLUETOOTH_SCO
                ) {
                    val productName = info.productName?.toString() ?: "Bluetooth Audio"
                    val exists = targets.any { it.name.equals(productName, ignoreCase = true) }
                    if (!exists) {
                        targets.add(
                            AudioDeviceItem(
                                id = "AUDIO_DEV_${info.id}",
                                name = "$productName (نشط)",
                                isBluetooth = true
                            )
                        )
                    }
                }
            }
        }

        return targets
    }

    fun saveRule(packageName: String, targetId: String) {
        prefs.edit().putString(packageName, targetId).apply()
    }

    fun getRule(packageName: String): String {
        return prefs.getString(packageName, "DEFAULT_SPEAKER") ?: "DEFAULT_SPEAKER"
    }

    fun applyRoutingForTarget(targetId: String) {
        if (targetId.startsWith("BT_") || targetId.startsWith("AUDIO_DEV_")) {
            audioManager.mode = AudioManager.MODE_NORMAL
            audioManager.stopBluetoothSco()
            audioManager.isBluetoothScoOn = false
        } else {
            audioManager.stopBluetoothSco()
            audioManager.isBluetoothScoOn = false
            audioManager.mode = AudioManager.MODE_NORMAL
        }
    }
}
